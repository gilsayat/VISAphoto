name: Build USVisaPhotoAutomator EXE

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Setup .NET 8 SDK
        uses: actions/setup-dotnet@v5
        with:
          dotnet-version: '8.0.x'

      - name: Restore win-x64 dependencies
        run: dotnet restore -r win-x64

      - name: Publish slim single-file EXE (win-x64)
        run: >
          dotnet publish
          -c Release
          -r win-x64
          --no-restore
          -o ./Publish

      - name: Create Models placeholder folder in Publish output
        run: New-Item -ItemType Directory -Force -Path ./Publish/Models

      # NEW STEP: Explicitly copy the WebGPU assets to the publish folder
      - name: Copy wwwroot to Publish output
        run: Copy-Item -Path ./wwwroot -Destination ./Publish/wwwroot -Recurse -Force

      - name: Upload USVisaPhotoAutomator EXE artifact
        uses: actions/upload-artifact@v4
        with:
          name: USVisaPhotoAutomator-maxquality-win-x64
          path: ./Publish/
          retention-days: 30
