<Window x:Class="USVisaPhotoAutomator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="US Visa Photo Automator" Height="820" Width="480"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White" FontFamily="Segoe UI"
        Icon="pack://application:,,,/app.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Visa Photo Engine" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="Automatic DoS Compliance Formatting" FontSize="13" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Drop Zone (Compact Card Style) -->
        <Border x:Name="DropBorder" Grid.Row="1" Background="#252526" CornerRadius="10"
                BorderBrush="#3F3F46" BorderThickness="2" ClipToBounds="True"
                AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
            <Grid>
                <StackPanel x:Name="PlaceholderUI" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📁" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#1E90FF"/>
                    <TextBlock Text="Drag &amp; Drop Photo Here" FontSize="16" FontWeight="Medium" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                    <Button Content="Or Browse Files..." Width="130" Height="30" Margin="0,15,0,0"
                            Background="#333337" Foreground="White" BorderBrush="#555555"
                            Click="BtnBrowse_Click" Cursor="Hand"/>
                </StackPanel>

                <!-- Hardware-Accelerated Preview Image -->
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="10" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="PreviewRotation" Angle="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                
                <!-- Alignment Grid Overlay -->
                <Border x:Name="AlignmentGrid" BorderBrush="#5000FFFF" BorderThickness="1" IsHitTestVisible="False" Margin="10" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,1,1" BorderBrush="#5000FFFF"/>
                        <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,1,1" BorderBrush="#5000FFFF"/>
                        <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,1,1" BorderBrush="#5000FFFF"/>
                        <Border Grid.Row="1" Grid.Column="1" BorderThickness="0,0,1,1" BorderBrush="#5000FFFF"/>
                        <Rectangle Grid.RowSpan="3" Grid.Column="1" Width="1" Fill="#90FF0000" HorizontalAlignment="Center"/>
                        <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" Fill="#90FF0000" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Controls, Progress, & Status -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <!-- Row 1: Format, Edge, BgColor -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Fmt:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbFormat" Width="75" SelectedIndex="0" Background="#333337" Foreground="Black">
                        <ComboBoxItem Content="JPG"/>
                        <ComboBoxItem Content="PNG"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Edge:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbEdgeMode" Width="95" SelectedIndex="0" Background="#333337" Foreground="Black">
                        <ComboBoxItem Content="Auto" Tag="AutoSmart"/>
                        <ComboBoxItem Content="Sharp" Tag="Sharp"/>
                        <ComboBoxItem Content="Balanced" Tag="Balanced"/>
                        <ComboBoxItem Content="Soft" Tag="Soft"/>
                    </ComboBox>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="BG:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbBgColor" Width="85" SelectedIndex="0" Background="#333337" Foreground="Black">
                        <ComboBoxItem Content="White"/>
                        <ComboBoxItem Content="Off-White"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Row 2: Layout & DPI -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Layout:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbLayout" Width="120" SelectedIndex="0" Background="#333337" Foreground="Black">
                        <ComboBoxItem Content="Digital 2x2" Tag="Digital2x2"/>
                        <ComboBoxItem Content="Print 4x6" Tag="Print4x6"/>
                        <ComboBoxItem Content="Print 4x8" Tag="Print4x8"/>
                        <ComboBoxItem Content="Print 5x10" Tag="Print5x10"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="DPI:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbDPI" Width="85" SelectedIndex="0" Background="#333337" Foreground="Black">
                        <ComboBoxItem Content="300 DPI"/>
                        <ComboBoxItem Content="600 DPI"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Row 3: Fix Lighting & Show Grid -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkFixLighting" Grid.Column="0" Content="Fix Lighting (Exposure/Shadows)"
                          IsChecked="False" Foreground="#AAAAAA" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <CheckBox x:Name="ChkGrid" Grid.Column="1" Content="Show Guide Grid"
                          IsChecked="True" Foreground="#AAAAAA" VerticalAlignment="Center" HorizontalAlignment="Right" Click="ChkGrid_Click"/>
            </Grid>

            <!-- Row 4: Butter-Smooth Manual Tilt & Zoom Sliders -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tilt:" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                <Slider x:Name="TiltSlider" Grid.Column="1" Minimum="-25" Maximum="25" Value="0" 
                        TickFrequency="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="TiltSlider_ValueChanged"/>
                <TextBlock x:Name="LblTiltAngle" Grid.Column="2" Text="0.0°" Foreground="#AAAAAA" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
            
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Zoom:" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="50" Maximum="69" Value="56" 
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged"/>
                <TextBlock x:Name="LblZoomValue" Grid.Column="2" Text="56%" Foreground="#AAAAAA" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>

            <!-- Row 5: Generate Button -->
            <Button x:Name="BtnGenerate" Content="Generate Visa Photo" Height="38" 
                    Background="#1E90FF" Foreground="White" FontWeight="Bold" FontSize="14"
                    Margin="0,0,0,12" Cursor="Hand" IsEnabled="False" Click="BtnGenerate_Click"/>

            <!-- Loading Bar -->
            <ProgressBar x:Name="ProcessingProgress" IsIndeterminate="True" Height="4" Visibility="Collapsed"
                         Background="#333337" Foreground="#1E90FF" BorderThickness="0" Margin="0,0,0,10"/>

            <!-- Status Card -->
            <Border Background="#2D2D30" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblStatus" Grid.Column="0" Text="Waiting for image..." FontSize="13"
                               TextWrapping="Wrap" Foreground="#00FF7F" VerticalAlignment="Center"/>
                    <Button x:Name="BtnOpenFolder" Grid.Column="1" Content="View File" Width="70" Height="26"
                            Background="#1E90FF" Foreground="White" BorderThickness="0"
                            Visibility="Collapsed" Click="BtnOpenFolder_Click" Cursor="Hand"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Signature -->
        <TextBlock Grid.Row="3" Text="Created by Gil" FontSize="11" Foreground="#555555"
                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </Grid>
</Window>
