<Window x:Class="USVisaPhotoAutomator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="US Visa Photo Automator - WebGPU Engine" Height="820" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#121214" Foreground="White" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- The Invisible Browser! Fixed: Moved out of the direct grid root children mix -->
        <wpf:WebView2 x:Name="AiBrowser" Visibility="Collapsed" Grid.Column="0" />

        <!-- LEFT PANE -->
        <Grid Grid.Column="0" Background="#0A0A0C">
            <TextBlock Text="Shift+Scroll: Tilt  |  Scroll: Zoom  |  Drag: Pan" Foreground="#55555A" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0"/>

            <Border x:Name="CanvasBorder" Width="600" Height="600" Background="#FFFFFF" CornerRadius="2" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"
                    AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown" MouseLeftButtonUp="Canvas_MouseLeftButtonUp" 
                    MouseMove="Canvas_MouseMove" MouseWheel="Canvas_MouseWheel" MouseLeave="Canvas_MouseLeave" Cursor="Hand">
                <Grid>
                    <StackPanel x:Name="PlaceholderUI" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📸" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#1E90FF"/>
                        <TextBlock Text="Drop Portrait Here" FontSize="18" FontWeight="Bold" Foreground="#888890" HorizontalAlignment="Center"/>
                        <Button Content="Browse..." Width="100" Height="30" Margin="0,20,0,0" Background="#1E1E22" Foreground="White" BorderBrush="#333338" Click="BtnBrowse_Click" Cursor="Hand"/>
                    </StackPanel>
                    <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" />
                    
                    <Canvas x:Name="VisaBlueprint" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.95">
                        <Rectangle Fill="#5000FF00" Width="600" Height="78" Canvas.Top="186" />
                        <Line X1="260" Y1="225" X2="340" Y2="225" Stroke="#E0000000" StrokeThickness="2" StrokeDashArray="2 2"/>
                        <Line X1="300" Y1="0" X2="300" Y2="600" Stroke="#A0FF0000" StrokeThickness="1" StrokeDashArray="4 4"/>
                        <Line X1="0" Y1="42" X2="600" Y2="42" Stroke="#A0000000" StrokeThickness="1" StrokeDashArray="4 4" />
                        <Line X1="0" Y1="150" X2="600" Y2="150" Stroke="#A0000000" StrokeThickness="1" StrokeDashArray="4 4" />
                        <Line X1="565" Y1="42" X2="565" Y2="450" Stroke="#D0000000" StrokeThickness="2" />
                        <Line X1="550" Y1="42" X2="580" Y2="42" Stroke="#D0000000" StrokeThickness="2" />
                        <Line X1="550" Y1="150" X2="580" Y2="150" Stroke="#D0000000" StrokeThickness="2" />
                        <Line X1="0" Y1="450" X2="600" Y2="450" Stroke="#A0000000" StrokeThickness="1" StrokeDashArray="4 4" />
                        <Line X1="550" Y1="450" X2="580" Y2="450" Stroke="#D0000000" StrokeThickness="2" />
                        <Path Stroke="#C0000000" StrokeThickness="2" StrokeDashArray="4 4" Fill="Transparent" Data="M 210,320 C 210,480 270,450 300,450 C 330,450 390,480 390,320 C 390,120 370,80 300,80 C 230,80 210,120 210,320 Z"/>
                        <Rectangle Width="600" Height="600" Stroke="#50000000" StrokeThickness="2"/>
                    </Canvas>
                </Grid>
            </Border>
            <ProgressBar x:Name="ProcessingProgress" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed" Background="Transparent" Foreground="#1E90FF" BorderThickness="0"/>
        </Grid>

        <!-- RIGHT PANE -->
        <Border Grid.Column="1" Background="#18181A" BorderBrush="#252528" BorderThickness="1,0,0,0" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="AUTO ID" FontSize="26" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,0,5" />
                    <TextBlock Text="WebGPU Transformer Engine" FontSize="11" Foreground="#77777C" Margin="0,0,0,30" />
                    
                    <TextBlock Text="OUTPUT SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#66666B" Margin="0,0,0,10"/>
                    <ComboBox x:Name="CmbLayout" Height="36" Margin="0,0,0,12" SelectedIndex="0" Background="White" Foreground="Black" BorderThickness="1" BorderBrush="#333338" Padding="10,0" FontSize="13" SelectionChanged="Setting_Changed">
                        <ComboBox.Resources><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="Black"/><Setter Property="Background" Value="White"/></Style></ComboBox.Resources>
                        <ComboBoxItem Content="Print Sheet 4x6 (6 Photos)" Foreground="Black"/>
                        <ComboBoxItem Content="Print Sheet 4x8 (8 Photos)" Foreground="Black"/>
                        <ComboBoxItem Content="Print Sheet 5x10 (8 Photos)" Foreground="Black"/>
                        <ComboBoxItem Content="Digital Single (2x2)" Foreground="Black"/>
                    </ComboBox>

                    <ComboBox x:Name="CmbBgColor" Height="36" Margin="0,0,0,25" SelectedIndex="0" Background="White" Foreground="Black" BorderThickness="1" BorderBrush="#333338" Padding="10,0" FontSize="13" SelectionChanged="Setting_Changed">
                        <ComboBox.Resources><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="Black"/><Setter Property="Background" Value="White"/></Style></ComboBox.Resources>
                        <ComboBoxItem Content="Pure White Background" Foreground="Black"/>
                        <ComboBoxItem Content="Studio Off-White Background" Foreground="Black"/>
                    </ComboBox>
                    
                    <Border Background="#222226" BorderBrush="#333338" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,25">
                        <StackPanel>
                            <TextBlock Text="RMBG-1.4 VISION TRANSFORMER" Foreground="#E4E4E7" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Optical edge refinement is active. Sliders are no longer required." Foreground="#9A9AA0" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnSnapAuto" Content="⟲ Snap to AI Crop" Height="32" Background="#222226" Foreground="#EEEEEE" BorderBrush="#333338" FontSize="12" Cursor="Hand" Click="BtnSnapAuto_Click" Margin="0,0,0,20"/>
                    
                    <!-- COMPLIANCE -->
                    <Border x:Name="CompliancePanel" Background="#1C1C1F" BorderBrush="#252528" BorderThickness="1" CornerRadius="4" Padding="15" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="U.S. VISA COMPLIANCE" FontSize="10" FontWeight="Bold" Foreground="#66666B" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblOverallPass" Text="PASS" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,10"><TextBlock Text="Head Height" FontSize="12" Foreground="#9A9AA0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="ValHeadHeight" Text="-" FontSize="11" Foreground="#E4E4E7" FontFamily="Consolas" Margin="0,0,15,0" VerticalAlignment="Center"/><TextBlock x:Name="StatHeadHeight" Text="PASS" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" Width="35" TextAlignment="Right"/></StackPanel></Grid>
                            <Grid Margin="0,0,0,10"><TextBlock Text="Eye Level" FontSize="12" Foreground="#9A9AA0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="ValEyeLevel" Text="-" FontSize="11" Foreground="#E4E4E7" FontFamily="Consolas" Margin="0,0,15,0" VerticalAlignment="Center"/><TextBlock x:Name="StatEyeLevel" Text="PASS" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" Width="35" TextAlignment="Right"/></StackPanel></Grid>
                            <Grid Margin="0,0,0,10"><TextBlock Text="Centering" FontSize="12" Foreground="#9A9AA0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="ValCentering" Text="-" FontSize="11" Foreground="#E4E4E7" FontFamily="Consolas" Margin="0,0,15,0" VerticalAlignment="Center"/><TextBlock x:Name="StatCentering" Text="PASS" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" Width="35" TextAlignment="Right"/></StackPanel></Grid>
                            <Grid><TextBlock Text="Head Level" FontSize="12" Foreground="#9A9AA0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="ValHeadLevel" Text="-" FontSize="11" Foreground="#E4E4E7" FontFamily="Consolas" Margin="0,0,15,0" VerticalAlignment="Center"/><TextBlock x:Name="StatHeadLevel" Text="PASS" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" Width="35" TextAlignment="Right"/></StackPanel></Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Export Action -->
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="LblStatus" Text="Initializing WebGPU Engine..." FontSize="11" Foreground="#88888D" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Button x:Name="BtnGenerate" Content="GENERATE PRINT" Height="50" Background="#0066FF" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" IsEnabled="False" Click="BtnGenerate_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="BtnOpenFolder" Content="Open Output Folder" Height="30" Margin="0,10,0,0" Background="Transparent" Foreground="#1E90FF" BorderThickness="0" Visibility="Collapsed" Click="BtnOpenFolder_Click" Cursor="Hand"/>
                    <TextBlock Text="Created by Gil" FontSize="10" Foreground="#444448" HorizontalAlignment="Right" Margin="0,20,0,0" FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>