<Window x:Class="USVisaPhotoAutomator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="US Visa Photo Automator - Real-Time Studio" Height="780" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#18181A" Foreground="White" FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANE: 1:1 Live Viewport -->
        <Grid Grid.Column="0" Background="#121214">
            <Border x:Name="DropBorder" Background="#202024" CornerRadius="8" BorderBrush="#333338" BorderThickness="2" 
                    Width="600" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"
                    AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
                <Grid>
                    <StackPanel x:Name="PlaceholderUI" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📁" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#1E90FF"/>
                        <TextBlock Text="Drop Photo to Initialize Engine" FontSize="16" FontWeight="SemiBold" Foreground="#DDDDDD" HorizontalAlignment="Center"/>
                        <Button Content="Browse Files..." Width="120" Height="30" Margin="0,15,0,0" Background="#2D2D32" Foreground="White" BorderBrush="#555555" Click="BtnBrowse_Click" Cursor="Hand"/>
                    </StackPanel>

                    <!-- TRUE Live Render Output -->
                    <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                    
                    <!-- U.S. Visa HUD Overlay (Static on top of output) -->
                    <Grid x:Name="VisaHUD" IsHitTestVisible="False" Visibility="Collapsed">
                        <Rectangle Fill="#2500FF00" Height="78" VerticalAlignment="Bottom" Margin="0,0,0,336"/> <!-- 56-69% Zone on 600px -->
                        <Rectangle Fill="#40FFFFFF" Width="1" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
                        <TextBlock Text="Safe Eye Zone" FontSize="12" Foreground="#8000FF00" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,345" VerticalAlignment="Bottom"/>
                    </Grid>
                    
                    <ProgressBar x:Name="ProcessingProgress" IsIndeterminate="True" Height="6" VerticalAlignment="Bottom" Visibility="Collapsed" Background="Transparent" Foreground="#1E90FF" BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT PANE: Studio Controls -->
        <Border Grid.Column="1" Background="#1E1E22" BorderBrush="#333338" BorderThickness="1,0,0,0" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="STUDIO CONTROLS" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,0,20"/>
                    
                    <!-- 1. Output Settings Panel -->
                    <Border Background="#25252A" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="OUTPUT SETTINGS" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,10"/>
                            <ComboBox x:Name="CmbLayout" Margin="0,0,0,10" SelectedIndex="0" Background="#333338" Foreground="Black" SelectionChanged="Cmb_SelectionChanged">
                                <ComboBoxItem Content="Digital 2x2" Tag="Digital2x2"/>
                                <ComboBoxItem Content="Print 4x6" Tag="Print4x6"/>
                                <ComboBoxItem Content="Print 4x8" Tag="Print4x8"/>
                                <ComboBoxItem Content="Print 5x10" Tag="Print5x10"/>
                            </ComboBox>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbBgColor" Grid.Column="0" SelectedIndex="0" Background="#333338" Foreground="Black" SelectionChanged="Cmb_SelectionChanged">
                                    <ComboBoxItem Content="Pure White"/>
                                    <ComboBoxItem Content="Off-White"/>
                                </ComboBox>
                                <ComboBox x:Name="CmbEdgeMode" Grid.Column="2" SelectedIndex="0" Background="#333338" Foreground="Black" SelectionChanged="Cmb_SelectionChanged">
                                    <ComboBoxItem Content="Smart Edge" Tag="AutoSmart"/>
                                    <ComboBoxItem Content="Soft Edge" Tag="Soft"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. Geometry & Framing Panel -->
                    <Border Background="#25252A" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="FRAMING (REAL-TIME COMPOSITE)" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Zoom:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="-15" Maximum="25" Value="0" ValueChanged="Slider_UpdateUI"/>
                                <TextBlock x:Name="LblZ" Grid.Column="2" Text="0" Foreground="#888888" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Tilt:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <Slider x:Name="TiltSlider" Grid.Column="1" Minimum="-25" Maximum="25" Value="0" ValueChanged="Slider_UpdateUI"/>
                                <TextBlock x:Name="LblT" Grid.Column="2" Text="0°" Foreground="#888888" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Pan X:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <Slider x:Name="PanXSlider" Grid.Column="1" Minimum="-40" Maximum="40" Value="0" ValueChanged="Slider_UpdateUI"/>
                                <TextBlock x:Name="LblX" Grid.Column="2" Text="0" Foreground="#888888" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Pan Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <Slider x:Name="PanYSlider" Grid.Column="1" Minimum="-40" Maximum="40" Value="0" ValueChanged="Slider_UpdateUI"/>
                                <TextBlock x:Name="LblY" Grid.Column="2" Text="0" Foreground="#888888" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. Lighting & Retouching Panel -->
                    <Border Background="#25252A" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="LIGHTING &amp; EDGES" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Brightness:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <Slider x:Name="BrightSlider" Grid.Column="1" Minimum="-50" Maximum="50" Value="0" ValueChanged="Slider_UpdateUI"/>
                                <TextBlock x:Name="LblB" Grid.Column="2" Text="0" Foreground="#888888" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Recovery:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <Slider x:Name="RecovSlider" Grid.Column="1" Minimum="0" Maximum="50" Value="0" ValueChanged="Slider_UpdateUI"/>
                                <TextBlock x:Name="LblR" Grid.Column="2" Text="0" Foreground="#888888" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Temp:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <Slider x:Name="TempSlider" Grid.Column="1" Minimum="-30" Maximum="30" Value="0" ValueChanged="Slider_UpdateUI"/>
                                <TextBlock x:Name="LblC" Grid.Column="2" Text="0" Foreground="#888888" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Mask Choke:" Foreground="#CCCCCC" VerticalAlignment="Center" FontSize="10"/>
                                <Slider x:Name="ChokeSlider" Grid.Column="1" Minimum="-6" Maximum="6" Value="0" ValueChanged="Slider_UpdateUI"/>
                                <TextBlock x:Name="LblE" Grid.Column="2" Text="0" Foreground="#888888" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Export Action -->
                    <Button x:Name="BtnGenerate" Content="Generate High-Res Print File" Height="45" Background="#1E90FF" Foreground="White" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" Cursor="Hand" IsEnabled="False" Click="BtnGenerate_Click"/>
                    
                    <Border Background="#202024" CornerRadius="4" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblStatus" Grid.Column="0" Text="Awaiting initialization..." FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                            <Button x:Name="BtnOpenFolder" Grid.Column="1" Content="View Folder" Width="80" Height="24" Background="#333338" Foreground="White" BorderThickness="0" Visibility="Collapsed" Click="BtnOpenFolder_Click" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
