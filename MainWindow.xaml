<Window x:Class="USVisaPhotoAutomator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="US Visa Photo Automator - Master Studio" Height="900" Width="480"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Visa Photo Studio" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="Pro AI Segmentation &amp; Layout Engine" FontSize="13" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Square 1:1 Viewport for exact Visa framing preview -->
        <Border x:Name="DropBorder" Grid.Row="1" Background="#252526" CornerRadius="4"
                BorderBrush="#3F3F46" BorderThickness="1" ClipToBounds="True"
                AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                Width="320" Height="320" HorizontalAlignment="Center">
            <Grid>
                <StackPanel x:Name="PlaceholderUI" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📁" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#1E90FF"/>
                    <TextBlock Text="Drop Photo Here" FontSize="14" FontWeight="Medium" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                    <Button Content="Browse..." Width="100" Height="26" Margin="0,10,0,0"
                            Background="#333337" Foreground="White" BorderBrush="#555555" Click="BtnBrowse_Click" Cursor="Hand"/>
                </StackPanel>

                <!-- Hardware-Accelerated Image Container -->
                <Image x:Name="PreviewImage" Stretch="UniformToFill" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="PreviewRotation" Angle="0"/>
                            <TranslateTransform x:Name="PreviewTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                
                <!-- U.S. Visa HUD Overlay -->
                <Grid x:Name="VisaHUD" IsHitTestVisible="False" Visibility="Collapsed">
                    <!-- Safe Eye Zone (56% to 69% from bottom) -->
                    <Rectangle Fill="#3000FF00" Height="41.6" VerticalAlignment="Bottom" Margin="0,0,0,179.2"/>
                    <!-- Center Line -->
                    <Rectangle Fill="#50FFFFFF" Width="1" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
                    <TextBlock Text="Safe Eye Zone" FontSize="10" Foreground="#9000FF00" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,185" VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Studio Controls -->
        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <ComboBox x:Name="CmbLayout" Grid.Column="0" Margin="0,0,5,0" SelectedIndex="0" Background="#333337" Foreground="Black">
                    <ComboBoxItem Content="Digital 2x2" Tag="Digital2x2"/>
                    <ComboBoxItem Content="Print 4x6" Tag="Print4x6"/>
                    <ComboBoxItem Content="Print 4x8" Tag="Print4x8"/>
                    <ComboBoxItem Content="Print 5x10" Tag="Print5x10"/>
                </ComboBox>
                <ComboBox x:Name="CmbBgColor" Grid.Column="1" Margin="5,0,5,0" SelectedIndex="0" Background="#333337" Foreground="Black">
                    <ComboBoxItem Content="Pure White"/>
                    <ComboBoxItem Content="Off-White"/>
                </ComboBox>
                <ComboBox x:Name="CmbEdgeMode" Grid.Column="2" Margin="5,0,0,0" SelectedIndex="0" Background="#333337" Foreground="Black">
                    <ComboBoxItem Content="Smart Edge" Tag="AutoSmart"/>
                    <ComboBoxItem Content="Soft Edge" Tag="Soft"/>
                    <ComboBoxItem Content="Sharp Edge" Tag="Sharp"/>
                </ComboBox>
            </Grid>

            <!-- Sliders Box -->
            <Border Background="#252526" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Zoom:" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="-10" Maximum="20" Value="0" ValueChanged="Slider_UpdateUI"/>
                        <TextBlock x:Name="LblZ" Grid.Column="2" Text="0" Foreground="#AAAAAA" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Tilt:" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <Slider x:Name="TiltSlider" Grid.Column="1" Minimum="-25" Maximum="25" Value="0" ValueChanged="Slider_UpdateUI"/>
                        <TextBlock x:Name="LblT" Grid.Column="2" Text="0°" Foreground="#AAAAAA" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Pan X:" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <Slider x:Name="PanXSlider" Grid.Column="1" Minimum="-50" Maximum="50" Value="0" ValueChanged="Slider_UpdateUI"/>
                        <TextBlock x:Name="LblX" Grid.Column="2" Text="0" Foreground="#AAAAAA" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Pan Y:" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <Slider x:Name="PanYSlider" Grid.Column="1" Minimum="-50" Maximum="50" Value="0" ValueChanged="Slider_UpdateUI"/>
                        <TextBlock x:Name="LblY" Grid.Column="2" Text="0" Foreground="#AAAAAA" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Bright:" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <Slider x:Name="BrightSlider" Grid.Column="1" Minimum="-50" Maximum="50" Value="0" ValueChanged="Slider_UpdateUI"/>
                        <TextBlock x:Name="LblB" Grid.Column="2" Text="0" Foreground="#AAAAAA" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Temp:" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <Slider x:Name="TempSlider" Grid.Column="1" Minimum="-30" Maximum="30" Value="0" ValueChanged="Slider_UpdateUI"/>
                        <TextBlock x:Name="LblC" Grid.Column="2" Text="0" Foreground="#AAAAAA" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Edge Fix:" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <Slider x:Name="ChokeSlider" Grid.Column="1" Minimum="-4" Maximum="4" Value="0" ValueChanged="Slider_UpdateUI"/>
                        <TextBlock x:Name="LblE" Grid.Column="2" Text="0" Foreground="#AAAAAA" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="BtnGenerate" Content="Generate Professional Output" Height="40" 
                    Background="#1E90FF" Foreground="White" FontWeight="Bold" FontSize="14"
                    Margin="0,0,0,10" Cursor="Hand" IsEnabled="False" Click="BtnGenerate_Click"/>

            <ProgressBar x:Name="ProcessingProgress" IsIndeterminate="True" Height="4" Visibility="Collapsed" Background="#333337" Foreground="#1E90FF" BorderThickness="0" Margin="0,0,0,10"/>

            <Border Background="#2D2D30" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblStatus" Grid.Column="0" Text="Waiting for image..." FontSize="12" TextWrapping="Wrap" Foreground="#00FF7F" VerticalAlignment="Center"/>
                    <Button x:Name="BtnOpenFolder" Grid.Column="1" Content="View File" Width="70" Height="26" Background="#1E90FF" Foreground="White" BorderThickness="0" Visibility="Collapsed" Click="BtnOpenFolder_Click" Cursor="Hand"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
